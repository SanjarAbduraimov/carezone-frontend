# Environment variables for carezone.uz
# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-strong-secret"

# Email (Nodemailer SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user@example.com"
SMTP_PASS="password"
SMTP_FROM="Carezone.uz <no-reply@carezone.uz>"

# UploadThing
UPLOADTHING_TOKEN="ut-xxxxxxxxxxxxxxxx"

# Stripe (optional deposit)
STRIPE_SECRET_KEY="sk_live_or_test"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Public site config
NEXT_PUBLIC_SITE_NAME="carezone.uz"
NEXT_PUBLIC_PRIMARY_COLOR="#10b981"
NEXT_PUBLIC_TELEGRAM_HANDLE="SanjarAbduraimov"
SHOW_DOMAIN_FOR_SALE_BANNER="true"
DOMAIN_FOR_SALE_CONTACT="@SanjarAbduraimov"
